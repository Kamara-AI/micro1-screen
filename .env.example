# SCREEN — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── LLM Provider Chain ────────────────────────────────────────────────────────
# SCREEN selects the provider in priority order: OpenRouter → OpenAI → Gemini.
# Set the key for whichever provider you want to use. Only one is required.

# Primary: OpenRouter (recommended — provider-agnostic, cost arbitrage, model fallback)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Secondary: OpenAI direct (same API format as OpenRouter — zero code changes)
OPENAI_API_KEY=

# Tertiary: Gemini (backward-compatible fallback for local dev)
GEMINI_API_KEY=

# ── Model Configuration ───────────────────────────────────────────────────────
# WHY these defaults: tier1 = fast flash models (extraction/generation tasks);
# tier2/3 = capable mid-tier models (reasoning, analysis, synthesis tasks).
# Override these to tune the cost-quality tradeoff for your use case.

# OpenRouter model slugs (use exact openrouter.ai/models slug format)
OPENROUTER_MODEL_TIER1=google/gemini-flash-1.5    # Tier 1: extraction + generation
OPENROUTER_MODEL_TIER2=anthropic/claude-3.5-haiku # Tier 2: reasoning + analysis
OPENROUTER_MODEL_TIER3=anthropic/claude-3.5-haiku # Tier 3: synthesis + brief writing

# OpenAI model names (used when OPENAI_API_KEY is set and OPENROUTER_API_KEY is not)
OPENAI_MODEL_TIER1=gpt-4o-mini
OPENAI_MODEL_TIER2=gpt-4o-mini
OPENAI_MODEL_TIER3=gpt-4o-mini

# Gemini model names (tertiary fallback)
GEMINI_MODEL_TIER1=gemini-1.5-flash
GEMINI_MODEL_TIER2=gemini-1.5-pro
GEMINI_MODEL_TIER3=gemini-1.5-pro

LLM_TEMPERATURE=0.1                              # Low temp for consistent analytical output
LLM_MAX_RETRIES=3                                # Retry cap
LLM_TIMEOUT_SECONDS=30                           # Per-call timeout

# ── Confidence Thresholds ─────────────────────────────────────────────────────
STRONG_YES_THRESHOLD=80.0
YES_THRESHOLD=65.0
AMBIGUOUS_THRESHOLD=45.0
NO_THRESHOLD=25.0

# ── Escalation Triggers ───────────────────────────────────────────────────────
ESCALATE_ON_CRITICAL_CONTRADICTION=true
ESCALATE_ON_BIAS_FLAG=true
ESCALATE_ON_UNVERIFIABLE_HIGH_CONFIDENCE=true

# ── External Claim Verification ───────────────────────────────────────────────
TAVILY_API_KEY=                                  # Web search claim verification (optional)
GITHUB_TOKEN=                                    # GitHub PAT — raises rate limit to 5k req/hr
MAX_NEW_CLAIMS_FROM_GITHUB=3                     # Cap on auto-discovered repo claims

# ── Environment ───────────────────────────────────────────────────────────────
ENV=dev
LOG_LEVEL=INFO
TIMEZONE=Africa/Nairobi                          # EAT — UTC+3 for all timestamps
