# SCREEN — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── LLM APIs ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here          # Primary LLM (Gemini Pro)
OPENAI_API_KEY=                                   # Fallback only — leave empty if not used

# ── Model Configuration ───────────────────────────────────────────────────────
GEMINI_MODEL_TIER1=gemini-1.5-flash              # Fast pre-filter (cheap, <$0.001)
GEMINI_MODEL_TIER2=gemini-1.5-pro               # Deep analysis (capable, ~$0.01)
GEMINI_MODEL_TIER3=gemini-1.5-pro               # Human brief (most capable, ~$0.05)
LLM_TEMPERATURE=0.1                              # Low temp for consistent analytical output
LLM_MAX_RETRIES=3                                # Retry cap (Rule 07 equivalent)
LLM_TIMEOUT_SECONDS=30                           # Per-call timeout

# ── Confidence Thresholds ─────────────────────────────────────────────────────
STRONG_YES_THRESHOLD=80.0                        # % — above this = STRONG_YES
YES_THRESHOLD=65.0                               # % — above this = YES
AMBIGUOUS_THRESHOLD=45.0                         # % — above this = AMBIGUOUS
NO_THRESHOLD=25.0                                # % — above this = NO
                                                 #    below this  = STRONG_NO

# ── Escalation Triggers ───────────────────────────────────────────────────────
ESCALATE_ON_CRITICAL_CONTRADICTION=true          # Always escalate on impossible timelines etc.
ESCALATE_ON_BIAS_FLAG=true                       # Always escalate when bias detected
ESCALATE_ON_UNVERIFIABLE_HIGH_CONFIDENCE=true   # Escalate when strong but unverifiable

# ── Environment ───────────────────────────────────────────────────────────────
ENV=dev                                          # dev | staging | prod
LOG_LEVEL=INFO                                   # DEBUG | INFO | WARNING | ERROR

# ── Timezone ──────────────────────────────────────────────────────────────────
TIMEZONE=Africa/Nairobi                          # EAT — UTC+3 for all timestamps
